            "creation_date": "2026-10-13T18:46:59Z",
            "definition": "{\n  \"Comment\": \"Order processing workflow\",\n  \"StartAt\": \"ReserveInventory\",\n  \"States\": {\n    \"ReserveInventory\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:lambda:eu-north-1:567764214274:function:reserve-inventory-lambda\",\n      \"Next\": \"MarkInventoryReserved\",\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\"OutOfStockError\"],\n          \"ResultPath\": null,\n          \"Next\": \"RejectOutOfStock\"\n        }\n      ]\n    },\n    \"MarkInventoryReserved\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::dynamodb:updateItem\",\n      \"Parameters\": {\n        \"TableName\": \"orders\",\n        \"Key\": {\n          \"orderId\": {\n            \"S.$\": \"$.orderId\"\n          }\n        },\n        \"UpdateExpression\": \"SET #status = :newStatus\",\n        \"ConditionExpression\": \"#status = :expectedStatus\",\n        \"ExpressionAttributeNames\": {\n          \"#status\": \"status\"\n        },\n        \"ExpressionAttributeValues\": {\n          \":newStatus\": {\n            \"S\": \"INVENTORY_RESERVED\"\n          },\n          \":expectedStatus\": {\n            \"S\": \"NEW\"\n          }\n        }\n      },\n      \"Next\": \"ProcessPayment\"\n    },\n    \"ProcessPayment\": {\n      \"Type\": \"Pass\",\n      \"Next\": \"Success\"\n    },\n    \"RejectOutOfStock\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"arn:aws:states:::dynamodb:updateItem\",\n      \"Parameters\": {\n        \"TableName\": \"orders\",\n        \"Key\": {\n          \"orderId\": {\n            \"S.$\": \"$.orderId\"\n          }\n        },\n        \"UpdateExpression\": \"SET #status = :newStatus, #reason = :reason\",\n        \"ConditionExpression\": \"#status = :expectedStatus\",\n        \"ExpressionAttributeNames\": {\n          \"#status\": \"status\",\n          \"#reason\": \"reason\"\n        },\n        \"ExpressionAttributeValues\": {\n          \":newStatus\": {\n            \"S\": \"REJECTED\"\n          },\n          \":reason\": {\n            \"S\": \"OUT_OF_STOCK\"\n          },\n          \":expectedStatus\": {\n            \"S\": \"NEW\"\n          }\n        }\n      },\n      \"Next\": \"Rejected\"\n    },\n    \"Rejected\": {\n      \"Type\": \"Succeed\"\n    },\n    \"Success\": {\n      \"Type\": \"Succeed\"\n    }\n  }\n}\n",
