{
  "Comment": "Order processing workflow",
  "StartAt": "ReserveInventory",
  "States": {
    "ReserveInventory": {
      "Type": "Task",
      "Resource": "${reserve_inventory_lambda_arn}",
      "Next": "MarkInventoryReserved",
      "Catch": [
        {
          "ErrorEquals": ["OutOfStockError"],
          "ResultPath": null,
          "Next": "RejectOutOfStock"
        }
      ]
    },
    "MarkInventoryReserved": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "ResultPath": null,
      "Parameters": {
        "TableName": "${orders_table_name}",
        "Key": {
          "orderId": {
            "S.$": "$.orderId"
          }
        },
        "UpdateExpression": "SET #status = :newStatus",
        "ConditionExpression": "#status = :expectedStatus",
        "ExpressionAttributeNames": {
          "#status": "status"
        },
        "ExpressionAttributeValues": {
          ":newStatus": {
            "S": "INVENTORY_RESERVED"
          },
          ":expectedStatus": {
            "S": "NEW"
          }
        }
      },
      "Next": "GeneratePaymentId"
    },
    "GeneratePaymentId": {
      "Type": "Pass",
      "Parameters": {
        "paymentId.$": "States.UUID()"
      },
      "ResultPath": "$.paymentAttempt",
      "Next": "CreatePaymentAttempt"
    },
    "CreatePaymentAttempt": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "${payments_table_name}",
        "Item": {
          "orderId": {
            "S.$": "$.orderId"
          },
          "paymentId": {
            "S.$": "$.paymentAttempt.paymentId"
          },
          "status": {
            "S": "CREATED"
          }
        },
        "ConditionExpression": "attribute_not_exists(orderId) AND attribute_not_exists(paymentId)"
      },
      "ResultPath": null,
      "Next": "ProcessPayment"
    },
    "ProcessPayment": {
      "Type": "Task",
      "Resource": "${fake_payment_provider_lambda_arn}",
      "Parameters": {
        "orderId.$": "$.orderId",
        "items.$": "$.items",
        "paymentScenario.$": "$.paymentScenario",
        "retryCount.$": "$$.State.RetryCount"
      },
      "ResultPath": "$.payment",

      "Retry": [
        {
          "ErrorEquals": ["RetryablePaymentError"],
          "IntervalSeconds": 2,
          "BackoffRate": 2,
          "MaxAttempts": 3,
          "JitterStrategy": "FULL"
        }
      ],

      "Catch": [
        {
          "ErrorEquals": ["RetryablePaymentError"],
          "ResultPath": null,
          "Next": "ReleaseInventoryPaymentUnavailable"
        }
      ],

      "Next": "CheckPaymentResult"
    },
    "CheckPaymentResult": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.payment.status",
          "StringEquals": "SUCCEEDED",
          "Next": "Success"
        },
        {
          "Variable": "$.payment.status",
          "StringEquals": "DECLINED",
          "Next": "ReleaseInventoryPaymentDeclined"
        }
      ],
      "Default": "UnexpectedPaymentResult"
    },
    "ReleaseInventoryPaymentDeclined": {
      "Type": "Task",
      "Resource": "${release_inventory_lambda_arn}",
      "Parameters": {
        "orderId.$": "$.orderId",
        "items.$": "$.items",
        "compensationReason": "PAYMENT_DECLINED"
      },
      "ResultPath": null,
      "Next": "Rejected"
    },
    "ReleaseInventoryPaymentUnavailable": {
      "Type": "Task",
      "Resource": "${release_inventory_lambda_arn}",
      "Parameters": {
        "orderId.$": "$.orderId",
        "items.$": "$.items",
        "compensationReason": "PAYMENT_PROVIDER_UNAVAILABLE"
      },
      "ResultPath": null,
      "Next": "Rejected"
    },
    "UnexpectedPaymentResult": {
      "Type": "Fail",
      "Error": "UnexpectedPaymentResult"
    },
    "RejectOutOfStock": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${orders_table_name}",
        "Key": {
          "orderId": {
            "S.$": "$.orderId"
          }
        },
        "UpdateExpression": "SET #status = :newStatus, #reason = :reason",
        "ConditionExpression": "#status = :expectedStatus",
        "ExpressionAttributeNames": {
          "#status": "status",
          "#reason": "reason"
        },
        "ExpressionAttributeValues": {
          ":newStatus": {
            "S": "REJECTED"
          },
          ":reason": {
            "S": "OUT_OF_STOCK"
          },
          ":expectedStatus": {
            "S": "NEW"
          }
        }
      },
      "Next": "Rejected"
    },
    "Rejected": {
      "Type": "Succeed"
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}
